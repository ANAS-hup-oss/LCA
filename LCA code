struct LCA {
    int n, LOG;
    vector<vector<int> > ancestor;
    vector<int> depth;

    LCA(int n) : n(n) {
        LOG = 19;
        ancestor.assign(n + 1, vector<int>(LOG));
        depth.assign(n + 1, 0);
    }

    void dfs(int v, int p, const vector<vector<int> > &adj) {
        ancestor[v][0] = p;

        for (int j = 1; j < LOG; j++)
            ancestor[v][j] = ancestor[ancestor[v][j - 1]][j - 1];

        for (auto u: adj[v]) {
            if (u == p) continue;
            depth[u] = depth[v] + 1;
            dfs(u, v, adj);
        }
    }

    void build(int root, const vector<vector<int> > &adj) {
        dfs(root, root, adj);
    }

    int kth_ancestor(int v, int k) {
        for (int j = LOG - 1; j >= 0; j--)
            if (k & (1 << j))
                v = ancestor[v][j];
        return v;
    }

    void add_node(int v, int p) {
        // with N
        depth[v] = depth[p] + 1;
        ancestor[v][0] = p;

        for (int j = 1; j < LOG; j++) {
            ancestor[v][j] = ancestor[ancestor[v][j - 1]][j - 1];
        }
    }

    int query(int a, int b) {
        if (a == b) return a;

        if (depth[a] < depth[b]) swap(a, b);

        a = kth_ancestor(a, depth[a] - depth[b]);

        if (a == b) return a;

        for (int j = LOG - 1; j >= 0; j--)
            if (ancestor[a][j] != ancestor[b][j]) {
                a = ancestor[a][j];
                b = ancestor[b][j];
            }

        return ancestor[a][0];
    }

    int dist(int a, int b) {
        int l = query(a, b);
        return depth[a] + depth[b] - 2 * depth[l];
    }
};
